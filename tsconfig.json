{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "allowUnreachableCode": false,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "types": ["vite/client", "bun"],

    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  }
}
